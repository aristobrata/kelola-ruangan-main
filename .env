#--------------------------------------------------------------------
# CONFIGURATION ENVIRONMENT (LINGKUNGAN KERJA)
#--------------------------------------------------------------------
# Nilai: development (pengembangan), production (live/produksi), atau testing (pengujian)
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP (PENGATURAN APLIKASI)
#--------------------------------------------------------------------
# URL dasar aplikasi Anda (diakhiri dengan garis miring '/')
app.baseURL = 'http://localhost:8080/'

# Menghapus index.php dari URL jika menggunakan mod_rewrite (.htaccess)
app.indexPage = ''

# Zona waktu default aplikasi (contoh: 'Asia/Jakarta' untuk WIB)
app.appTimezone = 'Asia/Jakarta'

# Bahasa default aplikasi (contoh: 'id' untuk Bahasa Indonesia, 'en' untuk Inggris)
app.defaultLocale = 'en'

# Memaksa koneksi HTTPS secara global (true / false)
app.forceGlobalSecureRequests = false

# Mengaktifkan Content Security Policy (CSP) untuk keamanan tambahan (true / false)
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE (PENGATURAN DATABASE UTAMA)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = kelola_ruangan
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

#--------------------------------------------------------------------
# DATABASE TESTS (DATABASE UNTUK TESTING/PENGUJIAN)
#--------------------------------------------------------------------
# Berguna saat Anda menjalankan PHPUnit agar tidak mengotori database utama
database.tests.hostname = localhost
database.tests.database = kelola_ruangan_test
database.tests.username = root
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_general_ci
database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION (KEAMANAN DEKRIPSI/ENKRIPSI)
#--------------------------------------------------------------------
# Kunci enkripsi wajib diisi untuk keamanan Session dan Cookie.
# Gunakan perintah "php spark key:generate" untuk mengisi otomatis dengan kunci yang aman.

encryption.key = hex2bin:d26591e610c1344a367b2d5f29e6e0031fc4343de7d1be1cb5b90ce8980e125b
#--------------------------------------------------------------------
# SESSION (PENGATURAN SESI PENGGUNA)
#--------------------------------------------------------------------
# Driver penyimpanan session (FileHandler, DatabaseHandler, dll.)
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# Lokasi penyimpanan session file (null berarti default ke writable/session)
session.savePath = null
# Masa berlaku session dalam detik (7200 detik = 2 jam, 0 = sampai browser ditutup)
session.expiration = 7200
# Nama cookie session yang disimpan di browser
session.cookieName = 'ci_session'

#--------------------------------------------------------------------
# SECURITY (CSRF & COOKIE)
#--------------------------------------------------------------------
# Melindungi dari serangan Cross-Site Request Forgery (CSRF)
# Nilai: 'cookie' atau 'session'
security.csrfProtection = 'cookie'
security.tokenRandomize = true
security.tokenName = 'csrf_test_name'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires = 7200
security.regenerate = true

#--------------------------------------------------------------------
# LOGGER (PENCATATAN LOG / ERROR)
#--------------------------------------------------------------------
# Tingkat ambang batas pencatatan log (0 = Nonaktif, 4 = Semua Log/Debug, dll.)
logger.threshold = 4
